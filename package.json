{
  "name": "acp-extension-claude",
  "version": "0.79.0",
  "description": "Forked ACP-compatible coding agent with improved timeout handling and logging",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "acp-extension-claude": "dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "example:simple-client": "node --experimental-strip-types --disable-warning=ExperimentalWarning examples/simple-client.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "release:preflight": "bash scripts/release-preflight.sh",
    "test": "vitest",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "acp",
    "agent",
    "anthropic",
    "typescript",
    "sdk",
    "code",
    "lody"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "acp-extension-core": "0.1.9",
    "diff": "9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
